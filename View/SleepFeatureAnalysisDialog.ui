     <widget class="QWidget" name="tab_band_power_trend">
      <attribute name="title">
       <string>频段功率趋势</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_band_power_trend">
       <item>
        <layout class="QGridLayout" name="gridLayout_band_power_params">
         <item row="0" column="0">
          <widget class="QLabel" name="label_sleep_channel">
           <property name="text">
            <string>通道</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1" colspan="3">
          <widget class="QComboBox" name="comboBox_sleep_channel"/>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="label_sleep_epoch">
           <property name="text">
            <string>epoch长度(s)</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QLineEdit" name="lineEdit_sleep_epoch_sec">
           <property name="text">
            <string>30</string>
           </property>
          </widget>
         </item>
         <item row="1" column="2">
          <widget class="QLabel" name="label_sleep_hop">
           <property name="text">
            <string>hop长度(s)</string>
           </property>
          </widget>
         </item>
         <item row="1" column="3">
          <widget class="QComboBox" name="comboBox_sleep_hop_sec">
           <property name="editable">
            <bool>true</bool>
           </property>
           <item>
            <property name="text">
             <string>30</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>5</string>
            </property>
           </item>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="label_sleep_time_start">
           <property name="text">
            <string>起始秒</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QLineEdit" name="lineEdit_sleep_start_sec"/>
         </item>
         <item row="2" column="2">
          <widget class="QLabel" name="label_sleep_time_end">
           <property name="text">
            <string>结束秒</string>
           </property>
          </widget>
         </item>
         <item row="2" column="3">
          <widget class="QLineEdit" name="lineEdit_sleep_end_sec"/>
         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="label_sleep_bands">
           <property name="text">
            <string>频段</string>
           </property>
          </widget>
         </item>
         <item row="3" column="1" colspan="3">
          <layout class="QHBoxLayout" name="horizontalLayout_sleep_bands">
           <item>
            <widget class="QCheckBox" name="checkBox_sleep_delta">
             <property name="text">
              <string>delta</string>
             </property>
             <property name="checked">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="checkBox_sleep_theta">
             <property name="text">
              <string>theta</string>
             </property>
             <property name="checked">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="checkBox_sleep_alpha">
             <property name="text">
              <string>alpha</string>
             </property>
             <property name="checked">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="checkBox_sleep_sigma">
             <property name="text">
              <string>sigma</string>
             </property>
             <property name="checked">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="checkBox_sleep_beta">
             <property name="text">
              <string>beta</string>
             </property>
             <property name="checked">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item row="4" column="0">
          <widget class="QLabel" name="label_sleep_power_type">
           <property name="text">
            <string>功率类型</string>
           </property>
          </widget>
         </item>
         <item row="4" column="1" colspan="3">
          <layout class="QHBoxLayout" name="horizontalLayout_sleep_power_type">
           <item>
            <widget class="QCheckBox" name="checkBox_sleep_absolute_power">
             <property name="text">
              <string>绝对功率</string>
             </property>
             <property name="checked">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="checkBox_sleep_relative_power">
             <property name="text">
              <string>相对功率</string>
