             <property name="checked">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="checkBox_sleep_exclude_bad">
             <property name="text">
              <string>排除会话红带坏段</string>
             </property>
             <property name="toolTip">
              <string>排除当前文件/通道在本次会话中已标红的坏段；不会写入文件，也不会给原数据打tag。</string>
